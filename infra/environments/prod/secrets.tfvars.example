# Copy to secrets.auto.tfvars (gitignored) and fill in. CI writes this file from
# GitHub secrets/vars in .github/workflows/infra-check.prod.yaml.
APPWRITE_ENDPOINT        = "https://fra.cloud.appwrite.io/v1"
APPWRITE_PROJECT_ID      = "your-project-id"
APPWRITE_API_KEY         = "your-api-key"         # needs wafRules.read + wafRules.write
APPWRITE_FUNCTIONS_TOKEN = "your-functions-token" # callers send it in x-functions-token
